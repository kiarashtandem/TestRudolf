# Plain KEY=value — works with Bash (`set -a; source .env; set +a`) and Fish (`source scripts/load-env.fish`).
# No `export`, no `${VAR:-default}` (Fish rejects those).

MINIO_BIN=minio
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio12345
MINIO_ROOT=$HOME/TestRudolf-minio-data
MINIO_API_HOST=127.0.0.1
# Default avoids Logitech G Hub (lghub_age) which often binds :9010 on macOS.
MINIO_API_PORT=9020
MINIO_CONSOLE_PORT=9201

RUDOLFS_HOST=127.0.0.1
RUDOLFS_PORT=8080
RUDOLFS_S3_BUCKET=rudolfs-lfs
RUDOLFS_ADMIN_TOKEN=dev-admin-change-me

# Where scripts/02-rudolfs.sh runs `cargo run` (default: ../rudolfs next to this repo)
# RUDOLFS_REPO=/Users/you/Projects/rudolfs

# SQLite path for Rudolfs (optional; default: TestRudolf/dev-meta/rudolfs_metadata.sqlite)
# RUDOLFS_METADATA_PATH=/Users/you/Projects/TestRudolf/dev-meta/rudolfs_metadata.sqlite

# Rudolfs also needs before `s3` subcommand (set in README / your shell session):
# AWS_S3_ENDPOINT=http://127.0.0.1:9020   # host:port must match MINIO_* above
# AWS_ACCESS_KEY_ID=minio                  # MINIO_ROOT_USER
# AWS_SECRET_ACCESS_KEY=minio12345           # MINIO_ROOT_PASSWORD
# AWS_DEFAULT_REGION=us-east-1
